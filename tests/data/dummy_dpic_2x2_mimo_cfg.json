{
    "Experiment": {
        "type": "EXPERIMENT",
        "enable_save": true,
        "save_dir": "./recordings",
        "file_name": "dummy_dpic_2x2_session.bvr",
        "disp_channels": ["Tx1Rx1", "Tx1Rx2", "Tx2Rx1", "Tx2Rx2"]
    },
    "Dummy_DPIC_2x2": {
        "type": "DUMMY",
        "signal_scheme": "cw",
        "samp_rate": 1000000,
        "chunk_duration": 0.02,
        "noise_std": 0.001,
        "hardware": {
            "MyB210_4": {
                "tx_channels": [0, 1],
                "rx_channels": [0, 1],
                "if_freq": [100000, 110000],
                "tx_amplitude": [1, 1],
                "tx_phase": [0, 0]
            },
            "MyB210_7": {
                "tx_channels": [0],
                "rx_channels": [0, 1],
                "if_freq": [100000],
                "tx_amplitude": [1],
                "tx_phase": [0]
            }
        },
        "channel_map": {
            "layout": "hybrid_mimo",
            "mimo": {
                "tx_global": [0, 1],
                "rx_global": [0, 1]
            },
            "dpic": [
                {
                    "inject_tx": 2,
                    "measure_tx": 0,
                    "measure_rx": 0
                }
            ]
        },
        "dpic_balance": {
            "auto_on_start": true,
            "amp_target": 0.5,
            "coarse_phase_step_deg": 12.0,
            "coarse_amp_step": 0.1,
            "coarse_probe_amplitude": 0.1,
            "phase_step_deg": 0.5,
            "amp_step": 0.005,
            "settle_time_s": 0.05
        },
        "calibration": {
            "enabled": false,
            "shape": "triangle",
            "inject_channels": [0],
            "record_reference": true
        },
        "rf_simulation": {
            "cross_coupling": 0.08,
            "on_axis_gain": 0.4,
            "direct_leak": 0.4,
            "dpic_coupling": 0.4
        }
    }
}
